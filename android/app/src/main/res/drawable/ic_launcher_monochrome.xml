<?xml version="1.0" encoding="utf-8"?>
<!--
  The themed-icon layer (Android 13+). The launcher tints it with one colour and
  reads only the alpha channel, so this is drawn as outlines rather than solid
  shapes: a filled document would come out as a featureless blob.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Sheet with a folded top-right corner. -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="5"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M30,24h30l20,20v40h-50z" />
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="5"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M60,24v20h20" />
    <!-- Text lines. -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:pathData="M41,58h28 M41,70h28" />
</vector>
