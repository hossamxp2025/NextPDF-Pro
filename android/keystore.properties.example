# Copy this file to android/keystore.properties and fill it in.
#
# keystore.properties is excluded from git; this example is not, because it
# holds no secret. Do not put real passwords in THIS file.
#
# storeFile may be an absolute path, or a path relative to the android/
# folder. Keeping the key OUTSIDE the repository is the safer choice: a
# .gitignore entry is one careless `git add -f` away from being bypassed.
#
# Nothing in the build has a default password. If this file is missing or any
# line below is empty, the release build is left unsigned on purpose, and
# Play rejects an unsigned upload - which is a loud failure rather than a
# silent one.

storeFile=C:/Users/YOU/keys/nextpdf-upload.jks
storePassword=
keyAlias=nextpdf-upload
keyPassword=
